#!/bin/sh
set -eu

if [ -z "${EMBER_DATA_DIR:-}" ]; then
    data_home=${XDG_DATA_HOME:-${HOME:?HOME must be set}/.local/share}
    export EMBER_DATA_DIR="$data_home/emberos"
fi

export PYTHONPATH="/opt/emberos${PYTHONPATH:+:$PYTHONPATH}"

case "${1:-}" in
    --version|-V)
        exec /opt/emberos/venv/bin/python -m emberos "$@"
        ;;
    --cli)
        shift
        exec /opt/emberos/venv/bin/python -m emberos "$@"
        ;;
    *)
        exec /opt/emberos/venv/bin/python /opt/emberos/web_ember.py "$@"
        ;;
esac
